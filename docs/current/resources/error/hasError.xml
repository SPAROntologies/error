>
  <rdf:Description rdf:about="http://www.essepuntato.it/2009/10/error#hasError">
    <vann:example>
    :my-resource
        error:hasError "This resource violates a constraint of the model."^^xsd:string .
    </vann:example>
    <rdfs:isDefinedBy rdf:resource="http://purl.org/spar/error"/>
    <rdfs:comment xml:lang="en">A description, usually in natural language, of which kind of error results from a resource.</rdfs:comment>
    <rdfs:domain rdf:nodeID="ndb32a9816e834574abfa8ac5eb20f7eeb1"/>
    <vs:term_status rdf:resource="http://purl.org/linked-data/registry#statusStable"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <skos:note xml:lang="en">A data property linking a resource that contains a logical error (which results in it belonging to the class `owl:Nothing`, therefore making the model inconsistent) to a textual description of that error.</skos:note>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">has error</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="ndb32a9816e834574abfa8ac5eb20f7eeb1">
    <owl:onProperty rdf:resource="http://www.essepuntato.it/2009/10/error#hasError"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
